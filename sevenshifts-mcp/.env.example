# Copy to .env (local) or .dev.vars (wrangler dev). Never commit the real values.

# Required: 7shifts API access token.
# Create at https://app.7shifts.com -> Settings -> Developer Tools -> API Access.
SEVENSHIFTS_TOKEN=

# Optional: skip the /whoami lookup by pinning the company id.
# SEVENSHIFTS_COMPANY_ID=435911

# Optional: pin the 7shifts API version.
# SEVENSHIFTS_API_VERSION=2026-06-01

# Optional: allow POST/PUT/PATCH/DELETE through sevenshifts_api_request.
# Leave false for a reporting/dashboard connector.
SEVENSHIFTS_ALLOW_WRITES=false

# Optional but recommended for a shared remote deployment: callers must send
# `Authorization: Bearer <this value>`. Generate with: openssl rand -hex 32
# MCP_SHARED_SECRET=
